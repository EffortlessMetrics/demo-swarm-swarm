{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demoswarm:schema:config:1",
  "title": "DemoSwarm project configuration v1",
  "type": "object",
  "required": ["schema_version", "repository", "platforms"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "required": ["provider", "default_branch"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "default_branch": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "test": { "$ref": "#/$defs/commandOrCommands" },
        "lint": { "$ref": "#/$defs/commandOrCommands" },
        "format": { "$ref": "#/$defs/commandOrCommands" },
        "policy": { "$ref": "#/$defs/commandOrCommands" }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "source_roots": { "$ref": "#/$defs/pathList" },
        "test_roots": { "$ref": "#/$defs/pathList" }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "object",
          "required": ["required_for_publish"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "required_for_publish": { "type": "boolean" },
            "command": { "$ref": "#/$defs/command" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "scope"],
        "properties": {
          "enabled": { "type": "boolean" },
          "scope": { "enum": ["project", "user"] },
          "mode": { "enum": ["native", "managed-files", "local", "bundle", "auto"] }
        },
        "additionalProperties": true
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["program"],
      "properties": {
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "commandOrCommands": {
      "oneOf": [
        { "$ref": "#/$defs/command" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } }
      ]
    },
    "pathList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
