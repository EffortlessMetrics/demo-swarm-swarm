{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demoswarm:schema:run:1",
  "title": "DemoSwarm run identity v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "pack_version",
    "producer",
    "repository"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "pack_version": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "required": ["host", "adapter_version"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["base_ref"],
      "properties": {
        "base_ref": { "type": "string", "minLength": 1 },
        "base_sha": { "type": ["string", "null"] },
        "current_sha": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "remote": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "bindings": { "type": "object" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
